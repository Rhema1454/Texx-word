function loadLevel(num){
  // If the player is returning to the very level they were already
  // mid-way through (and hadn't finished it), resume it exactly as
  // they left it — same found words, hints left, coins earned so
  // far, and wheel arrangement. Only start fresh if it's a different
  // level, or this one was already completed (replay).
  if (level && !level.isDaily && level.level === num && foundGrid.size < totalGridWords()){
    renderLevelUI();
    saveGame();
    return;
  }
  if (pendingSession && pendingSession.mode === 'level' && pendingSession.levelNum === num){
    restoreLevelFromSnapshot(pendingSession);
    pendingSession = null;
    renderLevelUI();
    saveGame();
    return;
  }
  level = generateLevel(num);
  resetLevelState();
  renderLevelUI();
  saveGame();
}
function loadDailyLevel(){
  const todayNum = todayDateNum();
  if (level && level.isDaily && level.dateNum === todayNum && foundGrid.size < totalGridWords()){
    renderLevelUI();
    saveGame();
    return;
  }
  if (pendingSession && pendingSession.mode === 'daily' && pendingSession.dateNum === todayNum){
    restoreLevelFromSnapshot(pendingSession);
    pendingSession = null;
    renderLevelUI();
    saveGame();
    return;
  }
  level = generateDailyChallenge();
  resetLevelState();
  renderLevelUI();
  saveGame();
}
function startDailyChallenge(){
  showScreen('screen-game');
  loadDailyLevel();
}
function resetLevelState(){
  foundGrid = new Set();
  foundBonus = new Set();

    rows, cols, cellMap,
    hintsTotal: hintsForTier(tierIdx),
    isDaily: false
  }, meta);
}
function generateLevel(level){
  const tierIdx = tierIndexForLevel(level);
  return generateLevelCore(level, tierIdx, { level });
}
function todayDateNum(){
  const n = new Date();
  return n.getFullYear() * 10000 + (n.getMonth() + 1) * 100 + n.getDate();
}
function generateDailyChallenge(){
  const n = new Date();
  const dateNum = todayDateNum();
  const tierIdx = dateNum % TIER_NAMES.length;
  const dateLabel = `${n.getFullYear()}-${String(n.getMonth()+1).padStart(2,'0')}-${String(n.getDate()).padStart(2,'0')}`;
  const lvl = generateLevelCore(dateNum, tierIdx, { level: 'daily', isDaily: true, dateNum, dateLabel });
  return lvl;
}

/* ============================================================
   AUDIO ENGINE — everything is synthesized live with the Web
   Audio API. No external sound files: this keeps the game a
   single self-contained HTML file and sidesteps any music
   licensing question entirely. Each rank gets its own
   procedurally generated ambient loop (root note, scale, tempo,
   and timbre all shift with the rank), and there are three
   short synthesized cues: point gained, wrong word, level
   complete.
   ============================================================ */
let audioCtx = null, masterGain = null, musicGainNode = null, sfxGainNode = null;
let currentMusicTier = -1;
let musicOn = true, sfxOn = true;
let musicStopFlag = { stopped: true };

function ensureAudio(){
  if (!audioCtx){
    const AC = window.AudioContext || window.webkitAudioContext;
    if (!AC) return false;
    audioCtx = new AC();
    masterGain = audioCtx.createGain(); masterGain.gain.value = 1;
    musicGainNode = audioCtx.createGain(); musicGainNode.gain.value = musicOn ? 0.11 : 0;
    sfxGainNode = audioCtx.createGain(); sfxGainNode.gain.value = sfxOn ? 0.3 : 0;
    musicGainNode.connect(masterGain);
    sfxGainNode.connect(masterGain);
    masterGain.connect(audioCtx.destination);
  }
  if (audioCtx.state === 'suspended') audioCtx.resume();
  return true;
}

function playTone(freq, startTime, dur, wave, filterFreq, gainNode, peak){
  const osc = audioCtx.createOscillator();
  osc.type = wave;
  osc.frequency.setValueAtTime(freq, startTime);
  const filt = audioCtx.createBiquadFilter();
  filt.type = 'lowpass';
  filt.frequency.value = filterFreq;
  const g = audioCtx.createGain();
  g.gain.setValueAtTime(0.0001, startTime);
  g.gain.linearRampToValueAtTime(peak, startTime + 0.02);
  g.gain.exponentialRampToValueAtTime(0.0001, startTime + dur);
  osc.connect(filt); filt.connect(g); g.connect(gainNode);
  osc.start(startTime);
  osc.stop(startTime + dur + 0.05);
}

/* ---- rank (tier) music themes — procedurally derived, each
   rank sounds distinct: key/root, scale mood, tempo and
   waveform timbre all shift as the ranks get harder. ---- */
function themeForTier(tierIdx){
  const roots = [220.00,246.94,261.63,293.66,329.63,349.23,392.00,440.00,466.16,523.25,
                 587.33,659.25,698.46,783.99,880.00,932.33,1046.50,1174.66,1244.51,1318.51];
  const root = roots[tierIdx % roots.length];
  let scale, wave;
  if (tierIdx < 7){ scale = [0,2,4,7,9]; wave = 'sine'; }           // calm major pentatonic
  else if (tierIdx < 14){ scale = [0,2,3,5,7,8,10]; wave = 'triangle'; } // natural minor, a bit moodier
  else { scale = [0,2,3,5,7,8,11]; wave = 'sawtooth'; }             // harmonic minor, tense & bright
  const bpm = 66 + tierIdx * 3.6;
  const filterFreq = 850 + tierIdx * 130;
  const progression = [[0,2,4],[3,5,0],[4,6,1],[0,2,4]];
  return { root, scale, wave, bpm, filterFreq, progression };
}
function noteFreq(root, scale, degree, octaveShift){
  const len = scale.length;
  const idx = ((degree % len) + len) % len;
  const octave = Math.floor(degree / len) + (octaveShift || 0);
  return root * Math.pow(2, (scale[idx] + octave * 12) / 12);
}
function stopMusic(){
  musicStopFlag.stopped = true;
  currentMusicTier = -1;
}
// Backgrounding a tab/app doesn't stop a running AudioContext by
// itself — without this, music (and any in-flight sfx) would keep
// playing after switching away. Suspend on hide, resume on return.
document.addEventListener('visibilitychange', () => {
  if (!audioCtx) return;
  if (document.hidden){
    if (audioCtx.state === 'running') audioCtx.suspend();
  } else if (audioCtx.state === 'suspended' && currentMusicTier !== -1){
    audioCtx.resume();
  }
});
// Covers actually closing/navigating away (some mobile browsers
// fire this instead of, or in addition to, beforeunload).
window.addEventListener('pagehide', () => {
  saveGame();
  stopMusic();
  if (audioCtx && audioCtx.state === 'running') audioCtx.suspend();
});
function startMusicForTier(tierIdx){
  if (tierIdx === currentMusicTier) return; // same rank already looping — let it continue
  if (!ensureAudio()) return;
  musicStopFlag.stopped = true;              // signal any previous loop to stop
  const myFlag = { stopped: false };
  musicStopFlag = myFlag;
  currentMusicTier = tierIdx;
  const theme = themeForTier(tierIdx);
  const beatDur = 60 / theme.bpm;
  let step = 0;
  function loop(){
    if (myFlag.stopped) return;
    const chord = theme.progression[Math.floor(step / 4) % theme.progression.length];
    const degree = chord[step % chord.length];
    const freq = noteFreq(theme.root, theme.scale, degree, 0);
    const now = audioCtx.currentTime;
    playTone(freq, now, beatDur * 0.9, theme.wave, theme.filterFreq, musicGainNode, 0.22);
    if (step % 4 === 0){
      const bassFreq = noteFreq(theme.root, theme.scale, chord[0], -1);
      playTone(bassFreq, now, beatDur * 3.8, 'sine', theme.filterFreq * 0.45, musicGainNode, 0.16);
    }
    step++;
    setTimeout(loop, beatDur * 1000);
  }
  loop();
}

/* ---- sound effects ---- */
function sfxPoint(){
  if (!ensureAudio()) return;
  const now = audioCtx.currentTime;
  playTone(880, now, 0.12, 'sine', 4200, sfxGainNode, 0.5);
  playTone(1318.51, now + 0.05, 0.16, 'sine', 4200, sfxGainNode, 0.4);
}
function sfxAlreadyFound(){
  if (!ensureAudio()) return;
  playTone(440, audioCtx.currentTime, 0.09, 'triangle', 2200, sfxGainNode, 0.22);
}
function sfxWrong(){
  if (!ensureAudio()) return;
  const now = audioCtx.currentTime;
  playTone(220, now, 0.18, 'sawtooth', 800, sfxGainNode, 0.32);
  playTone(174.61, now + 0.09, 0.22, 'sawtooth', 700, sfxGainNode, 0.28);
}
function sfxComplete(){
  if (!ensureAudio()) return;
  const now = audioCtx.currentTime;
  [523.25, 659.25, 783.99, 1046.50].forEach((f, i) => {
    playTone(f, now + i * 0.09, 0.35, 'triangle', 5200, sfxGainNode, 0.45);
  });
}

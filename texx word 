/* ============================================================
   PROGRESS STATE + PERSISTENCE
   Saved to localStorage so the game resumes exactly where you
   left off — even after closing the browser/app — as long as
   that storage isn't cleared (e.g. via "clear app data" or a
   private/incognito session that discards it on close).
   Note: this save layer won't function inside Claude.ai's own
   in-chat preview sandbox (browser storage is blocked there by
   design), but it works normally once you download this file
   and open it directly, or host it yourself.
   ============================================================ */
const SAVE_KEY = 'lexiconForgeSave_v1';
const HINT_COST = 100;

const progress = {
  unlockedLevel: 1,
  stars: {},        // levelNum -> 1|2|3
  currentLevel: 1,
  dailyCompletedDates: new Set(), // dateNum values completed
  coins: 0,         // persistent wallet, accumulates across every level played
  roundsSinceAd: 0  // completed rounds since the last interstitial ad
};
let pendingSession = null; // an in-progress level snapshot restored from storage, awaiting resume
let pendingInterstitial = false;
let interstitialContinueAction = null;

let level = null;           // current generateLevel() result
let foundGrid = new Set();
let foundBonus = new Set();
let score = 0;
let hintsLeft = 0;
let selection = [];         // indices into level.letters currently chosen
let dragging = false;
let toastTimer = null;

/* ---------------- save / load ---------------- */
function currentSessionSnapshot(){
  if (!level) return pendingSession; // not yet resumed this visit — keep whatever was loaded
  if (foundGrid.size >= totalGridWords()) return null; // finished — nothing to resume
  const hintedCellKeys = [];
  for (const key in level.cellMap){
    const cell = level.cellMap[key];
    if (cell.found && !cell.words.some(w => foundGrid.has(w))) hintedCellKeys.push(key);
  }
  return {
    mode: level.isDaily ? 'daily' : 'level',
    levelNum: level.isDaily ? null : level.level,
    dateNum: level.isDaily ? level.dateNum : null,
    foundGridWords: Array.from(foundGrid),
    foundBonusWords: Array.from(foundBonus),
    hintsLeft, score,
    letters: level.letters,
    hintedCellKeys
  };
}
function saveGame(){
  try{
    const data = {
      unlockedLevel: progress.unlockedLevel,
      stars: progress.stars,
      currentLevel: progress.currentLevel,
      dailyCompletedDates: Array.from(progress.dailyCompletedDates),
      coins: progress.coins,
      roundsSinceAd: progress.roundsSinceAd,
      session: currentSessionSnapshot()
    };
    localStorage.setItem(SAVE_KEY, JSON.stringify(data));
  } catch(e){ /* storage unavailable in this environment — game still plays fine this session */ }
}
function loadGame(){
  try{
    const raw = localStorage.getItem(SAVE_KEY);
    if (!raw) return;
    const data = JSON.parse(raw);
    progress.unlockedLevel = data.unlockedLevel || 1;
    progress.stars = data.stars || {};
    progress.currentLevel = data.currentLevel || 1;
    progress.dailyCompletedDates = new Set(data.dailyCompletedDates || []);
    progress.coins = data.coins || 0;
    progress.roundsSinceAd = data.roundsSinceAd || 0;
    pendingSession = data.session || null;
  } catch(e){ /* no valid save found — start fresh */ }
}
function restoreLevelFromSnapshot(snap){
  if (snap.mode === 'daily') level = generateDailyChallenge();
  else level = generateLevel(snap.levelNum);
  level.letters = snap.letters;
  foundGrid = new Set(snap.foundGridWords);
  foundBonus = new Set(snap.foundBonusWords);
  hintsLeft = snap.hintsLeft;
  score = snap.score;
  selection = [];
  for (const word of foundGrid){
    const g = level.gridWords.find(gw => gw.word === word);
    if (g) for (const key of cellKeysForWord(g)) level.cellMap[key].found = true;
  }
  for (const key of (snap.hintedCellKeys || [])){
    if (level.cellMap[key]) level.cellMap[key].found = true;
  }
}


function tierCompletedCount(tIdx){
  let n = 0;
  const start = tIdx * LEVELS_PER_TIER + 1, end = start + LEVELS_PER_TIER - 1;
  for (let l = start; l <= end; l++) if (progress.stars[l]) n++;
  return n;
}
function packCompletedCount(tIdx, pIdx){
  let n = 0;
  const start = tIdx * LEVELS_PER_TIER + pIdx * LEVELS_PER_PACK + 1, end = start + LEVELS_PER_PACK - 1;
  for (let l = start; l <= end; l++) if (progress.stars[l]) n++;
  return n;
}

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Texx-word</title>
<link rel="manifest" href="manifest.json">
<meta name="theme-color" content="#1b1b1f">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Texx-word">
<link rel="apple-touch-icon" href="icon-192.png">
<link rel="icon" type="image/png" sizes="192x192" href="icon-192.png">
<link rel="icon" type="image/png" sizes="512x512" href="icon-512.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#1b1b1f;
  --ink-2:#232329;
  --ink-3:#2c2c34;
  --ink-deep:#0f0f12;
  --parchment:#f3ead9;
  --parchment-dim:#e4d6b8;
  --gold:#d4a537;
  --gold-bright:#f0c761;
  --gold-glow:rgba(240,199,97,.35);
  --teal:#3d8f89;
  --teal-dim:#2a615d;
  --crimson:#b8483d;
  --text-lo:#9a97a6;
  --text-hi:#f3ead9;
  --serif:'Fraunces', Georgia, serif;
  --sans:'Inter', system-ui, sans-serif;
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;height:100%;background:var(--ink);color:var(--text-hi);font-family:var(--sans);overflow:hidden;-webkit-tap-highlight-color:transparent;user-select:none;}
#app{position:relative;width:100%;height:100%;max-width:520px;margin:0 auto;background:
  radial-gradient(circle at 50% -10%, #322c46 0%, var(--ink) 48%, var(--ink-deep) 100%);
  overflow:hidden;}
#app::after{
  content:'';position:absolute;inset:0;pointer-events:none;z-index:1;opacity:.5;
  background-image:radial-gradient(rgba(255,255,255,.035) 1px, transparent 1px);
  background-size:3px 3px;
  mix-blend-mode:overlay;
}
.screen{position:absolute;inset:0;display:none;flex-direction:column;overflow-y:auto;-ms-overflow-style:none;scrollbar-width:none;}
.screen::-webkit-scrollbar{display:none;}
.screen.active{display:flex;}

/* ---------- shared bits ---------- */
.topbar{display:flex;align-items:center;justify-content:space-between;padding:18px 18px 8px;flex-shrink:0;}
.iconbtn{width:38px;height:38px;border-radius:10px;background:var(--ink-3);border:1px solid #3a3a44;color:var(--text-hi);font-size:18px;display:flex;align-items:center;justify-content:center;cursor:pointer;box-shadow:0 2px 0 rgba(0,0,0,.3), inset 0 1px 0 rgba(255,255,255,.05);}
.iconbtn:active{transform:scale(0.94);}
h1,h2,h3{font-family:var(--serif);margin:0;font-weight:600;}
.eyebrow{font-size:12.5px;color:var(--gold-bright);font-weight:700;display:inline-flex;align-items:center;gap:6px;}
.eyebrow::before{content:'';width:6px;height:6px;background:var(--gold);border-radius:1px;transform:rotate(45deg);flex-shrink:0;}
.btn{font-family:var(--sans);font-weight:700;border:none;border-radius:14px;padding:14px 22px;font-size:15px;cursor:pointer;letter-spacing:.02em;}
.btn-gold{background:linear-gradient(180deg,var(--gold-bright),var(--gold));color:#2a1f04;box-shadow:0 4px 0 #8a6a1e, 0 8px 18px rgba(212,165,55,.25), inset 0 1px 0 rgba(255,255,255,.4);}
.btn-gold:active{transform:translateY(3px);box-shadow:0 1px 0 #8a6a1e;}
.btn-ghost{background:rgba(255,255,255,.02);border:1.5px solid #4a4a56;color:var(--text-hi);}
.btn:disabled{opacity:.35;pointer-events:none;}

/* ---------- MENU ---------- */
#screen-menu{align-items:center;justify-content:center;text-align:center;padding:20px;gap:0;position:relative;}
#screen-menu::before{
  content:'';position:absolute;top:8%;left:50%;width:340px;height:340px;
  transform:translateX(-50%);border-radius:50%;pointer-events:none;
  background:radial-gradient(circle, var(--gold-glow) 0%, transparent 68%);
  animation:auraPulse 5s ease-in-out infinite;
}
@keyframes auraPulse{0%,100%{opacity:.55;transform:translateX(-50%) scale(1);}50%{opacity:.9;transform:translateX(-50%) scale(1.08);}}
.menu-badge{width:132px;height:132px;border-radius:50%;background:conic-gradient(from 220deg, var(--gold-bright), var(--teal), var(--gold-bright));display:flex;align-items:center;justify-content:center;margin-bottom:22px;box-shadow:0 10px 34px rgba(212,165,55,.3);position:relative;z-index:1;}
.menu-badge-inner{width:112px;height:112px;border-radius:50%;background:radial-gradient(circle at 35% 28%, var(--ink-3), var(--ink-2));display:flex;flex-direction:column;align-items:center;justify-content:center;box-shadow:inset 0 2px 6px rgba(0,0,0,.4);}
.menu-badge-inner .lvl{font-family:var(--serif);font-size:30px;font-weight:700;line-height:1;}
.menu-badge-inner .tier{font-size:10px;color:var(--gold-bright);text-transform:uppercase;letter-spacing:.1em;margin-top:4px;}
.menu-title-tiles{display:flex;align-items:center;justify-content:center;gap:5px;margin-bottom:14px;position:relative;z-index:1;flex-wrap:wrap;max-width:340px;}
.mt-tile{display:inline-flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:7px;background:linear-gradient(160deg, var(--parchment), var(--parchment-dim));border:1px solid #cbb98f;color:#2a1f04;font-family:var(--serif);font-weight:700;font-size:17px;box-shadow:0 3px 0 rgba(0,0,0,.35), inset 0 1px 0 rgba(255,255,255,.6);transform:rotate(var(--r,0deg));}
.mt-dash{color:var(--gold-bright);font-size:20px;font-weight:700;padding:0 1px;align-self:center;}
.menu-coins{position:relative;z-index:1;}
.menu-sub{position:relative;z-index:1;}
.menu-actions{position:relative;z-index:1;}
.menu-sub{color:var(--text-lo);font-size:14px;margin-bottom:34px;max-width:280px;}
.menu-coins{color:var(--gold-bright);font-weight:700;font-size:14px;margin-bottom:10px;}
.menu-actions{display:flex;flex-direction:column;gap:12px;width:220px;}

/* ---------- TIERS ---------- */
.tier-list{padding:4px 16px 24px;display:flex;flex-direction:column;gap:10px;}
.tier-card{display:flex;align-items:center;gap:14px;padding:14px;border-radius:16px;background:linear-gradient(180deg, var(--ink-3), var(--ink-2));border:1px solid #33333c;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.2), inset 0 1px 0 rgba(255,255,255,.03);transition:transform .1s;}
.tier-card:active{transform:scale(.98);}
.tier-card.locked{opacity:.4;pointer-events:none;}
.tier-card.current{border-color:var(--gold);box-shadow:0 0 0 1px var(--gold) inset;}
.tier-medal{width:46px;height:46px;border-radius:50%;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:19px;box-shadow:0 3px 0 rgba(0,0,0,.35), inset 0 1px 2px rgba(255,255,255,.5), inset 0 -3px 6px rgba(0,0,0,.25);}
.tier-info{flex:1;min-width:0;}
.tier-name{font-family:var(--serif);font-size:16px;font-weight:600;}
.tier-range{font-size:11px;color:var(--text-lo);}
.tier-bar{height:5px;border-radius:3px;background:#3a3a44;margin-top:6px;overflow:hidden;}
.tier-bar-fill{height:100%;background:linear-gradient(90deg,var(--teal),var(--gold-bright));}
.tier-pct{font-size:12px;color:var(--text-lo);width:36px;text-align:right;flex-shrink:0;}

/* ---------- PACKS ---------- */
.pack-grid{padding:10px 16px 24px;display:grid;grid-template-columns:repeat(2,1fr);gap:10px;}
.pack-card{padding:16px 14px;border-radius:14px;background:linear-gradient(180deg, var(--ink-3), var(--ink-2));border:1px solid #33333c;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.2);transition:transform .1s;}
.pack-card:active{transform:scale(.97);}
.pack-card.locked{opacity:.35;pointer-events:none;}
.pack-card .p-name{font-family:var(--serif);font-size:15px;font-weight:600;}
.pack-card .p-range{font-size:11px;color:var(--text-lo);margin-top:2px;}
.pack-card .tier-bar{margin-top:10px;}

/* ---------- LEVEL GRID ---------- */
.level-grid{padding:10px 16px 24px;display:grid;grid-template-columns:repeat(5,1fr);gap:10px;}

/* ---------- SETTINGS ---------- */
.settings-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;padding:24px 30px 8px;}
.settings-toggle{display:flex;flex-direction:column;align-items:center;gap:10px;cursor:pointer;}
.settings-toggle-circle{width:72px;height:72px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:28px;background:radial-gradient(circle at 32% 28%, var(--teal), var(--teal-dim));box-shadow:0 4px 0 rgba(0,0,0,.3), 0 8px 16px rgba(61,143,137,.25);transition:background .15s, box-shadow .15s, opacity .15s;}
.settings-toggle.off .settings-toggle-circle{background:#3a3a44;box-shadow:0 4px 0 rgba(0,0,0,.3);opacity:.55;}
.settings-toggle-label{font-size:13px;font-weight:700;color:var(--text-hi);}
.settings-section{padding:22px 24px 4px;}
.settings-about{text-align:center;color:var(--text-lo);font-size:11.5px;line-height:1.6;padding:26px 24px;}

.rate-card{margin:18px 24px 0;padding:20px 18px;border-radius:16px;background:linear-gradient(180deg, var(--ink-3), var(--ink-2));border:1px solid #33333c;text-align:center;}
.rate-title{font-size:16px;margin-bottom:6px;}
.rate-average{font-size:12.5px;color:var(--text-lo);margin-bottom:14px;min-height:16px;}
.rate-average .avg-stars{color:var(--gold-bright);letter-spacing:1px;}
.rate-stars{display:flex;justify-content:center;gap:6px;font-size:32px;margin-bottom:14px;}
.rate-star{color:#4a4a56;cursor:pointer;transition:transform .1s, color .1s;}
.rate-star:active{transform:scale(1.15);}
.rate-star.lit{color:var(--gold-bright);}
.rate-feedback{width:100%;min-height:64px;resize:vertical;background:var(--ink);border:1px solid #3a3a44;border-radius:10px;color:var(--text-hi);font-family:var(--sans);font-size:13px;padding:10px;margin-bottom:12px;}
.rate-feedback::placeholder{color:var(--text-lo);}
.rate-note{font-size:12px;color:var(--gold-bright);margin-top:10px;min-height:14px;}
.level-btn{aspect-ratio:1;border-radius:12px;background:linear-gradient(180deg, var(--ink-3), var(--ink-2));border:1px solid #3a3a44;display:flex;flex-direction:column;align-items:center;justify-content:center;font-weight:700;font-size:14px;cursor:pointer;color:var(--text-hi);position:relative;box-shadow:0 2px 0 rgba(0,0,0,.25);transition:transform .1s;}
.level-btn:active{transform:scale(.93);}
.level-btn.done{background:linear-gradient(160deg,var(--teal),var(--teal-dim));border-color:var(--teal);}
.level-btn.current{border-color:var(--gold);box-shadow:0 0 0 2px var(--gold) inset;}
.level-btn.locked{opacity:.3;pointer-events:none;}
.level-btn .stars{font-size:8px;color:var(--gold-bright);letter-spacing:1px;margin-top:2px;}

/* ---------- GAME ---------- */
#screen-game{padding:0;}
.game-top{display:flex;flex-direction:column;gap:8px;padding:14px 16px 8px;flex-shrink:0;}
.game-top-row1{display:flex;align-items:center;justify-content:space-between;gap:10px;}
.game-top .lvl-chip{font-family:var(--serif);font-size:15px;font-weight:600;text-align:center;}
.game-top .tier-chip{font-size:10px;color:var(--gold-bright);text-transform:uppercase;letter-spacing:.08em;text-align:center;}
.game-top-row3{display:flex;gap:8px;justify-content:flex-end;}
.progress-wrap{width:100%;flex-shrink:0;}
.progress-track{height:8px;border-radius:5px;background:#33333c;overflow:hidden;}
.progress-fill{height:100%;background:linear-gradient(90deg,var(--teal),var(--gold-bright));width:0%;transition:width .25s;}
.progress-label{font-size:10.5px;color:var(--text-lo);margin-top:3px;}
.bonus-chip{background:var(--ink-3);border-radius:10px;padding:6px 9px;font-size:11.5px;font-weight:700;color:var(--gold-bright);white-space:nowrap;}
.score-chip{color:var(--parchment);}

.grid-wrap{flex:1;display:flex;align-items:center;justify-content:center;padding:6px 10px;min-height:0;overflow:auto;}
#crossgrid{display:grid;gap:5px;}
.cell{width:34px;height:34px;border-radius:6px;position:relative;}
.cell.empty{background:transparent;}
.cell.tile{background:var(--parchment-dim);border:1px solid #cbb98f;}
.cell.tile.found{background:var(--parchment);border-color:var(--gold);animation:tileGlow .5s ease-out;}
.cell.tile .letter{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:var(--serif);font-weight:700;font-size:16px;color:#2a1f04;opacity:0;transform:scale(.5);transition:opacity .18s, transform .18s;}
.cell.tile.found .letter{opacity:1;transform:scale(1);}
@keyframes tileGlow{0%{box-shadow:0 0 0 rgba(240,199,97,0);}40%{box-shadow:0 0 14px 3px var(--gold-glow);}100%{box-shadow:0 0 0 rgba(240,199,97,0);}}

.toast{position:absolute;left:50%;top:38%;transform:translate(-50%,0);background:var(--ink-3);border:1px solid var(--gold);padding:8px 16px;border-radius:20px;font-weight:700;font-size:13px;opacity:0;pointer-events:none;transition:opacity .15s, transform .15s;z-index:20;}
.toast.show{opacity:1;transform:translate(-50%,-8px);}

.bonus-strip{display:flex;flex-wrap:wrap;gap:6px;justify-content:center;padding:2px 16px 4px;min-height:14px;flex-shrink:0;}
.bonus-word-chip{font-size:10.5px;background:var(--ink-3);color:var(--text-lo);padding:3px 8px;border-radius:8px;letter-spacing:.03em;}

.wheel-area{flex-shrink:0;display:flex;flex-direction:column;align-items:center;padding:6px 10px 22px;gap:12px;}
.current-word{height:30px;font-family:var(--serif);font-size:22px;font-weight:700;letter-spacing:.08em;color:var(--gold-bright);}
.wheel-box{position:relative;width:250px;height:250px;}
.wheel-box::before{
  content:'';position:absolute;inset:14px;border-radius:50%;
  border:1px dashed rgba(212,165,55,.18);pointer-events:none;
}
.wheel-box svg{position:absolute;inset:0;pointer-events:none;}
.wheel-letter{position:absolute;width:58px;height:58px;border-radius:50%;background:radial-gradient(circle at 32% 28%, #44444e, var(--ink-3));border:1.5px solid #4a4a56;display:flex;align-items:center;justify-content:center;font-family:var(--serif);font-size:22px;font-weight:700;color:var(--text-hi);transform:translate(-50%,-50%);touch-action:none;cursor:pointer;box-shadow:0 3px 0 rgba(0,0,0,.4), inset 0 1px 1px rgba(255,255,255,.12), inset 0 -4px 8px rgba(0,0,0,.3);transition:background .12s, border-color .12s, box-shadow .15s;}
.wheel-letter.sel{background:radial-gradient(circle at 32% 28%, var(--gold-bright), var(--gold));color:#2a1f04;border-color:var(--gold-bright);box-shadow:0 3px 0 #8a6a1e, inset 0 1px 1px rgba(255,255,255,.5), 0 0 18px var(--gold-glow);}
.wheel-actions{display:flex;gap:10px;}
.wheel-actions .btn{padding:10px 18px;font-size:13px;}

/* ---------- COMPLETE OVERLAY ---------- */
#overlay-complete{position:absolute;inset:0;background:rgba(15,15,18,.88);display:none;align-items:center;justify-content:center;z-index:50;padding:24px;}
#overlay-complete.show{display:flex;}
.complete-card{background:var(--ink-2);border:1px solid var(--gold);border-radius:22px;padding:32px 26px;text-align:center;max-width:320px;width:100%;position:relative;overflow:hidden;}
.stars-row{font-size:34px;letter-spacing:8px;margin:14px 0;color:#4a4a56;}
.stars-row .lit{color:var(--gold-bright);}
.star-slot{display:inline-block;opacity:0;transform:scale(.2);animation:starPop .45s cubic-bezier(.34,1.56,.64,1) forwards;}
.star-slot:nth-child(1){animation-delay:.05s;}
.star-slot:nth-child(2){animation-delay:.2s;}
.star-slot:nth-child(3){animation-delay:.35s;}
@keyframes starPop{0%{opacity:0;transform:scale(.2) rotate(-25deg);}70%{transform:scale(1.25) rotate(8deg);}100%{opacity:1;transform:scale(1) rotate(0);}}
.spark-burst{position:absolute;inset:0;pointer-events:none;overflow:visible;}
.spark{position:absolute;left:50%;top:38%;width:6px;height:6px;border-radius:50%;background:var(--gold-bright);opacity:0;animation:sparkFly .7s ease-out forwards;}
@keyframes sparkFly{0%{opacity:1;transform:translate(-50%,-50%) translate(0,0) scale(1);}100%{opacity:0;transform:translate(-50%,-50%) translate(var(--dx),var(--dy)) scale(.3);}}
@keyframes coinBump{0%{transform:scale(1);}35%{transform:scale(1.35);color:var(--gold-bright);}100%{transform:scale(1);}}
.coin-bump{animation:coinBump .4s ease-out;}
.complete-stats{display:flex;gap:8px;justify-content:center;margin-bottom:22px;}
.stat-pill{flex:1;background:var(--ink-3);border-radius:12px;padding:10px 4px;display:flex;flex-direction:column;gap:2px;}
.stat-val{font-family:var(--serif);font-weight:700;font-size:16px;color:var(--gold-bright);}
.stat-label{font-size:10px;color:var(--text-lo);text-transform:lowercase;}
.complete-actions{display:flex;flex-direction:column;gap:10px;}

/* ---------- ADS ---------- */
.ad-overlay{position:absolute;inset:0;background:rgba(10,10,12,.94);display:none;align-items:center;justify-content:center;z-index:70;padding:24px;}
.ad-overlay.show{display:flex;}
.ad-card{background:var(--ink-2);border:1px solid #3a3a44;border-radius:22px;padding:28px 24px;text-align:center;max-width:320px;width:100%;}
.ad-label{font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--text-lo);border:1px solid #3a3a44;display:inline-block;padding:3px 10px;border-radius:8px;margin-bottom:18px;}
.ad-creative{padding:18px 6px 22px;}
.ad-creative-icon{font-size:40px;margin-bottom:10px;}
.ad-creative-title{font-family:var(--serif);font-size:19px;font-weight:700;margin-bottom:6px;}
.ad-creative-sub{color:var(--text-lo);font-size:13px;line-height:1.5;}
.ad-timer{color:var(--gold-bright);font-size:13px;font-weight:700;margin-bottom:16px;}

#banner-ad-slot{position:absolute;left:0;right:0;bottom:0;height:44px;background:var(--ink-2);border-top:1px solid #3a3a44;display:none;align-items:center;justify-content:center;gap:8px;z-index:40;}
#app.ads-online #banner-ad-slot{display:flex;}
.banner-ad-label{font-size:9px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink);background:var(--gold-bright);padding:2px 6px;border-radius:4px;font-weight:800;}
.banner-ad-text{font-size:11.5px;color:var(--text-lo);}
#app.ads-online .screen{padding-bottom:44px;}
</style>
</head>
<body>
<div id="app">

  <!-- MENU -->
  <div class="screen active" id="screen-menu">
    <div class="iconbtn" onclick="openSettings()" style="position:absolute;top:18px;right:18px;">&#9881;</div>
    <div class="menu-badge"><div class="menu-badge-inner">
      <div class="lvl" id="menu-level">1</div>
      <div class="tier" id="menu-tier">Novice</div>
    </div></div>
    <div class="menu-title-tiles" role="img" aria-label="Texx-word">
      <span class="mt-tile" style="--r:-6deg">T</span>
      <span class="mt-tile" style="--r:4deg">E</span>
      <span class="mt-tile" style="--r:-3deg">X</span>
      <span class="mt-tile" style="--r:5deg">X</span>
      <span class="mt-dash">&ndash;</span>
      <span class="mt-tile" style="--r:-4deg">W</span>
      <span class="mt-tile" style="--r:3deg">O</span>
      <span class="mt-tile" style="--r:-5deg">R</span>
      <span class="mt-tile" style="--r:4deg">D</span>
    </div>
    <div class="menu-coins">&#129689; <span id="menu-coins">0</span> coins</div>
    <div class="menu-sub">Swipe letters to cast words and fill the crossword.</div>
    <div class="menu-actions">
      <button class="btn btn-gold" onclick="startCurrentLevel()">Play Level <span id="menu-play-level">1</span></button>
      <button class="btn btn-ghost" onclick="openTiers()">Choose a Rank</button>
      <button class="btn btn-ghost" id="daily-btn" onclick="startDailyChallenge()">&#127775; Daily Challenge</button>
    </div>
  </div>

  <!-- TIERS -->
  <div class="screen" id="screen-tiers">
    <div class="topbar">
      <div class="iconbtn" onclick="showScreen('screen-menu')">&#8592;</div>
      <div><h2>Choose your rank</h2></div>
      <div style="width:38px"></div>
    </div>
    <div class="tier-list" id="tier-list"></div>
  </div>

  <!-- PACKS -->
  <div class="screen" id="screen-packs">
    <div class="topbar">
      <div class="iconbtn" onclick="showScreen('screen-tiers')">&#8592;</div>
      <div><div class="eyebrow" id="pack-eyebrow">Rank</div><h2 id="pack-title">Novice</h2></div>
      <div style="width:38px"></div>
    </div>
    <div class="pack-grid" id="pack-grid"></div>
  </div>

  <!-- LEVELS -->
  <div c
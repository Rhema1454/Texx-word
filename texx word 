function pointsForWord(word, isBonus){
  // Grid words score more since they're required; real-but-unlisted bonus
  // words still earn a small reward instead of being rejected.
  // Tuned so a typical level (all grid words + ~half the bonus words) nets ~30 points.
  const base = isBonus ? 0.8 : 2;
  const mult = isBonus ? 0.2 : 0.4;
  return Math.max(1, Math.round(base + (word.length - 3) * mult));
}

/* ---------------- letter wheel ---------------- */
function renderWheel(){
  const box = document.getElementById('wheel-box');
  box.querySelectorAll('.wheel-letter').forEach(n => n.remove());
  const n = level.letters.length;
  const R = 95, cx = 125, cy = 125;
  const tileSize = n <= 6 ? 58 : (n <= 8 ? 50 : 44);
  level.letters.forEach((ch, i) => {
    const angle = (Math.PI * 2 * i / n) - Math.PI/2;
    const x = cx + R * Math.cos(angle);
    const y = cy + R * Math.sin(angle);
    const div = document.createElement('div');
    div.className = 'wheel-letter';
    div.style.left = x + 'px';
    div.style.top = y + 'px';
    div.style.width = tileSize + 'px';
    div.style.height = tileSize + 'px';
    div.style.fontSize = (tileSize * 0.38) + 'px';
    div.dataset.idx = i;
    div.textContent = ch.toUpperCase();
    div.addEventListener('pointerdown', onLetterDown);
    box.appendChild(div);
  });
  clearSelection();
}
function wheelLetterEls(){ return Array.from(document.querySelectorAll('.wheel-letter')); }

function onLetterDown(e){
  e.preventDefault();
  dragging = true;
  clearSelection();
  addToSelection(parseInt(e.currentTarget.dataset.idx, 10));
  document.addEventListener('pointermove', onPointerMove);
  document.addEventListener('pointerup', onPointerUp);
}
function onPointerMove(e){
  if (!dragging) return;
  const els = wheelLetterEls();
  for (const el of els){
    const idx = parseInt(el.dataset.idx, 10);
    if (selection.includes(idx)) continue;
    const rect = el.getBoundingClientRect();
    const dx = e.clientX - (rect.left + rect.width/2);
    const dy = e.clientY - (rect.top + rect.height/2);
    if (Math.sqrt(dx*dx + dy*dy) < rect.width * 0.62){
      addToSelection(idx);
    }
  }
  drawTether(e.clientX, e.clientY);
}
function onPointerUp(){
  dragging = false;
  document.removeEventListener('pointermove', onPointerMove);
  document.removeEventListener('pointerup', onPointerUp);
  submitSelection();
}
function addToSelection(idx){
  selection.push(idx);
  wheelLetterEls()[idx].classList.add('sel');
  document.getElementById('current-word').textContent = selection.map(i => level.letters[i]).join('').toUpperCase();
  drawTether(null);
}
function clearSelection(){
  selection = [];
  wheelLetterEls().forEach(el => el.classList.remove('sel'));
  document.getElementById('current-word').textContent = '';
  const svg = document.getElementById('wheel-svg');
  svg.innerHTML = '';
}
function drawTether(){
  const svg = document.getElementById('wheel-svg');
  svg.innerHTML = '';
  if (selection.length < 2) return;
  const els = wheelLetterEls();
  let d = '';
  selection.forEach((idx, i) => {
    const style = els[idx].style;
    const x = parseFloat(style.left), y = parseFloat(style.top);
    d += (i === 0 ? 'M' : 'L') + x + ',' + y + ' ';
  });
  const path = document.createElementNS('http://www.w3.org/2000/svg','path');
  path.setAttribute('d', d.trim());
  path.setAttribute('stroke', '#f0c761');
  path.setAttribute('stroke-width', '5');
  path.setAttribute('stroke-linecap', 'round');
  path.setAttribute('fill', 'none');
  path.setAttribute('opacity', '0.85');
  svg.appendChild(path);
}
function submitSelection(){
  const word = selection.map(i => level.letters[i]).join('').toLowerCase();
  clearSelection();
  if (word.length < 3) return;
  if (!level.allValid.has(word)){
    sfxWrong();
    showToast('Not a word');
    return;
  }
  const gridMatch = level.gridWords.find(g => g.word === word);
  if (gridMatch){
    if (foundGrid.has(word)){ sfxAlreadyFound(); showToast('Already found'); return; }
    foundGrid.add(word);
    const coins = pointsForWord(word, false);
    score += coins; // pending — only lands in the wallet if the level is completed
    revealGridWord(gridMatch);
    updateProgressBar();
    sfxPoint();
    showToast(word.toUpperCase() + '! +' + coins + ' coins');
    checkLevelComplete();
    saveGame();
    return;
  }
  if (foundBonus.has(word)){ sfxAlreadyFound(); showToast('Already found'); return; }
  foundBonus.add(word);
  const coins = pointsForWord(word, true);
  score += coins; // pending — only lands in the wallet if the level is completed
  renderBonusStrip();
  updateProgressBar();
  sfxPoint();
  showToast('+Bonus: ' + word.toUpperCase() + ' +' + coins + ' coins');
  saveGame();
}
function revealGridWord(g){
  for (let i = 0; i < g.word.length; i++){
    const r = g.dir === 'V' ? g.row + i : g.row;
    const c = g.dir === 'H' ? g.col + i : g.col;
    const key = r + '_' + c;
    level.cellMap[key].found = true;
    const cellEl = document.getElementById('cell-' + key);
    if (cellEl) cellEl.classList.add('found');
  }
}
function showToast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => t.classList.remove('show'), 900);
}
function shuffleWheel(){
  const rng = Math.random;
  for (let i = level.letters.length - 1; i > 0; i--){
    const j = Math.floor(rng() * (i + 1));
    [level.letters[i], level.letters[j]] = [level.letters[j], level.letters[i]];
  }
  renderWheel();
}
function cellKeysForWord(g){
  const keys = [];
  for (let i = 0; i < g.word.length; i++){
    const r = g.dir === 'V' ? g.row + i : g.row;
    const c = g.dir === 'H' ? g.col + i : g.col;
    keys.push(r + '_' + c);
  }
  return keys;
}
function revealOneHintLetter(){
  const candidates = [];
  for (const g of level.gridWords){
    if (foundGrid.has(g.word)) continue;
    for (const key of cellKeysForWord(g)){
      if (!level.cellMap[key].found) candidates.push(key);
    }
  }
  if (!candidates.length) return false;
  const key = candidates[Math.floor(Math.random() * candidates.length)];
  level.cellMap[key].found = true;
  const cellEl = document.getElementById('cell-' + key);
  if (cellEl) cellEl.classList.add('found');
  sfxAlreadyFound();
  showToast('Hint: revealed a letter');
  for (const g of level.gridWords){
    if (foundGrid.has(g.word)) continue;
    if (cellKeysForWord(g).every(k => level.cellMap[k].found)) foundGrid.add(g.word);
  }
  updateProgressBar();
  checkLevelComplete();
  saveGame();
  return true;
}
function useHint(){
  const anyUnrevealed = level.gridWords.some(g => !foundGrid.has(g.word) &&
    cellKeysForWord(g).some(k => !level.cellMap[k].found));
  if (!anyUnrevealed){ showToast('No hints needed'); return; }

  if (hintsLeft > 0){
    hintsLeft--;
    updateHintButton();
    revealOneHintLetter();
    return;
  }
  if (progress.coins >= HINT_COST){
    if (!confirm('Buy 1 hint for ' + HINT_COST + ' coins?')) return;
    progress.coins -= HINT_COST;
    updateHintButton();
    revealOneHintLetter();
    saveGame();
    return;
  }
  // out of free hints and can't afford one — offer a rewarded ad instead
  watchAdForHint();
}
function watchAdForHint(){
  if (!navigator.onLine){
    showToast('Watching ads needs an internet connection');
    return;
  }
  showRewardedAd(() => {
    revealOneHintLetter();
  });
}
function checkLevelComplete(){
  if (foundGrid.size < totalGridWords()) return;
  const bonusTotal = level.bonusWords.length;
  const bonusFound = foundBonus.size;
  let stars = 1;
  if (bonusTotal > 0){
    const ratio = bonusFound / bonusTotal;
    if (ratio >= 0.999) stars = 3;
    else if (ratio >= 0.5) stars = 2;
  } else {
    stars = 3;
  }
  if (level.isDaily){
    progress.dailyCompletedDates.add(level.dateNum);
  } else {
    progress.stars[level.level] = Math.max(progress.stars[level.level] || 0, stars);
    progress.unlockedLevel = Math.max(progress.unlockedLevel, level.level + 1);
  }
  progress.coins += score; // coins earned this attempt only land in the wallet on completion
  progress.roundsSinceAd++;
  if (progress.roundsSinceAd >= 2){
    pendingInterstitial = true;
    progress.roundsSinceAd = 0;
  }
  updateProgressBar();
  saveGame();
  setTimeout(() => showComplete(stars, bonusFound, bonusTotal), 500);
}
function showComplete(stars, bonusFound, bonusTotal){
  sfxComplete();
  document.getElementById('complete-title').textContent = level.isDaily ? 'Daily Challenge Cleared' : ('Level ' + level.level);
  const litStars = '&#9733;'.repeat(stars) + '&#9734;'.repeat(3 - stars);
  document.getElementById('complete-stars').innerHTML = litStars;
  document.getElementById('complete-stats').textContent =
    `${totalGridWords()}/${totalGridWords()} words · ${bonusFound}/${bonusTotal} bonus words · +${score} coins earned`;
  const primary = document.getElementById('complete-primary-btn');
  const secondary = document.getElementById('complete-secondary-btn');
  if (level.isDaily){
    primary.textContent = 'Back to Menu';
    primary.onclick = () => {
      document.getElementById('overlay-complete').classList.remove('show');
      showInterstitialThen(exitGame);
    };
    secondary.style.display = 'none';
  } else {
    primary.textContent = 'Next Level';
    primary.onclick = () => {
      document.getElementById('overlay-complete').classList.remove('show');
      showInterstitialThen(nextLevel);
    };
    secondary.style.display = '';
    secondary.onclick = () => {
      document.getElementById('overlay-complete').classList.remove('show');
      showInterstitialThen(closeCompleteToSelect);
    };
  }
  document.getElementById('overlay-complete').classList.add('show');
}
function nextLevel(){
  progress.currentLevel = Math.min(TOTAL_LEVELS, level.level + 1);
  loadLevel(progress.currentLevel);
}
function closeCompleteToSelect(){
  openPacks(tierIndexForLevel(level.level));
}

/* ---------------- boot ---------------- */
window.addEventListener('resize', () => {
  if (level && document.getElementById('screen-game').classList.contains('active')) renderGrid();
});
window.addEventListener('beforeunload', saveGame);
loadGame();
refreshMenu();
updateOnlineState();
if ('serviceWorker' in navigator){
  window.addEventListener('load', () => {
    navigator.serviceWorker.register('sw.js').catch(() => {
      // offline caching just won't be available — game still plays fine online
    });
  });
}
</script>
